    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function () {
            const iconConfigs = [
                { selector: '.fa-whatsapp', className: 'hld_sticky_whatsapp', labelSelector: '.fm-item-1-4 .fm-label' },
                { selector: '.fa-check', className: 'hld_sticky_applynow', labelSelector: '.fm-item-1-0 .fm-label' },
                { selector: '.fa-phone-flip', className: 'hld_sticky_tollfree', labelSelector: '.fm-item-1-1 .fm-label' },
                { selector: '.fa-envelope', className: 'hld_sticky_mail', labelSelector: '.fm-item-1-2 .fm-label' },
                { selector: '.fa-envelope-open-text', className: 'hld_sticky_enquiry', labelSelector: '.fm-item-1-3 .fm-label' }
            ];

            iconConfigs.forEach(function(config) {
                // Add class to all matching icon elements
                document.querySelectorAll(config.selector).forEach(function(icon) {
                    if (!icon.classList.contains(config.className)) {
                        icon.classList.add(config.className);
                    }
                });

                // Add class to all matching labels
                document.querySelectorAll(config.labelSelector).forEach(function(label) {
                    if (!label.classList.contains(config.className)) {
                        label.classList.add(config.className);
                    }
                });
            });
        });
    </script>
