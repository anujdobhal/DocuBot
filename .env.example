# Backend API Base URL
# By default, Vite proxies /api to http://localhost:5000
VITE_API_BASE_URL=/api

# Connect directly to backend RAG & ingestion server
VITE_USE_MOCK_FALLBACK=false

# Local Ollama LLM Configuration (running llama3.2:1b)
VITE_OLLAMA_URL=/api/ollama
VITE_OLLAMA_MODEL=llama3.2:1b

# Backend configuration
PORT=5000
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gehu_documents
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=80
